# mako — Do Not Disturb is a *mode*; custom/notify toggles "do-not-disturb"
# (`makoctl mode -t do-not-disturb`), bound to invisible=1 below.
# Mirrors the settings the NixOS module puts in services.mako.

font=JetBrainsMono Nerd Font 11
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#313244
progress-color=over #313244
border-radius=10
border-size=2
padding=10
margin=8
default-timeout=6000
anchor=top-right
layer=overlay
icons=1
max-icon-size=48
markup=1
width=360
height=140

[mode=do-not-disturb]
invisible=1

[urgency=critical]
border-color=#f38ba8
default-timeout=0
